import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct MessageData {
    author: string,
    content: string,
}

export component AppWindow inherits Window {
    title: "Discord Client";
    min-width: 800px;
    min-height: 600px;
    background: background-color;

    in property <string> visible-name: "Connecting...";
    in property <image> avatar-image;
    in property <[string]> private-channel-names: ["Connecting..."];
    in property <[image]> private-channel-avatars;
    in property <[MessageData]> messages: [{ author: "System", content: "No messages..." }];

    callback private-channel-clicked(int);

    property <color> primary-color: #5865f2;
    property <color> background-color: #36393f;
    property <color> card-color: #2f3136;
    property <color> text-color: #ffffff;
    property <color> author-color: #00b0f4;

    // Guilds column
    Rectangle {
        width: 80px;
        height: parent.height;
        x: 0;
        y: 0;
        background: card-color;

        Rectangle {
            y: 0;
            x: 10px;
            height: parent.height - 70px;
            width: parent.width - 10px;
        }
    }

    // Private channels column
    Rectangle {
        width: 250px;
        height: parent.height;
        x: 80px;
        y: 0;
        background: card-color;

        Rectangle {
            y: 20px;
            x: 5px;
            height: parent.height - 100px;
            width: parent.width - 10px;
            clip: true;

            ScrollView {
                width: parent.width;
                height: parent.height;

                VerticalBox {
                    spacing: 5px;
                    alignment: LayoutAlignment.start; // Fixed alignment constant

                    for private-channel[index] in private-channel-names: TouchArea {
                        width: 100%;
                        height: 35px;

                        property <bool> hovering: self.has-hover;

                        clicked => {
                            root.private-channel-clicked(index);
                        }

                        Rectangle {
                            background: hovering ? #ffffff18 : transparent;
                            border-radius: 5px;
                            animate background {
                                duration: 150ms;
                                easing: ease-in-out;
                            }

                            Rectangle {
                                width: 30px;
                                height: 30px;
                                x: 10px;
                                y: 2.5px;
                                border-radius: 15px;
                                clip: true;
                                background: #2e2d2d;
                                Image {
                                    source: private-channel-avatars[index];
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }

                            Text {
                                text: private-channel;
                                font-size: 14px;
                                color: hovering ? #ffffff : #b9bbbe;
                                x: 50px;
                                y: 8px;
                                width: parent.width - 60px;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                }
            }
        }
    }

    // Border
    Rectangle {
        x: 80px;
        width: 2px;
        height: parent.height - 110px;
        y: 20px;
        background: background-color.darker(-0.3);
        border-radius: 10px;
    }
    
    // User profile
    Rectangle {
        width: 310px;
        height: 60px;
        y: parent.height - self.height - 10px;
        x: 10px;
        background: background-color;
        border-radius: 8px;

        Rectangle {
            width: 50px;
            height: 50px;
            x: 10px;
            y: 5px;
            border-radius: 25px;
            clip: true;
            background: #2e2d2d;
            Image {
                source: avatar-image;
                width: parent.width;
                height: parent.height;
            }
        }

        Text {
            text: visible-name;
            font-size: 16px;
            font-weight: 900;
            x: 70px;
            width: parent.width - 80px;
            height: parent.height;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
    }

    // Messages area
    Rectangle {
        width: parent.width - 330px;
        height: parent.height;
        x: 330px;
        y: 0;
        background: background-color;

        ScrollView {
            width: parent.width - 20px;
            height: parent.height - 20px;
            x: 10px;
            y: 10px;

            VerticalBox {
                spacing: 10px;
                alignment: LayoutAlignment.start;
                width: parent.width;

                for message in messages: Rectangle {
                    width: 100%;
                    height: author-text.preferred-height + message-text.preferred-height + 30px;
                    background: transparent;

                    author-text := Text {
                        text: message.author;
                        color: author-color;
                        font-size: 14px;
                        font-weight: 600;
                        x: 10px;
                        y: 10px;
                        width: parent.width - 20px;
                    }

                    message-text := Text {
                        text: message.content;
                        color: text-color;
                        font-size: 14px;
                        x: 10px;
                        y: author-text.y + author-text.preferred-height + 5px;
                        width: parent.width - 20px;
                        wrap: TextWrap.word-wrap;
                    }
                }
            }
        }
    }
}
